{
  "functions": {
    "api/index.js": { "includeFiles": "app/pages/*.html" }
  },
  "routes": [
    { "src": "/app/(.+\\.(?:js|css|woff2))", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/docs/unduhan/(.*)", "headers": { "Cache-Control": "public, max-age=3600" }, "continue": true },
    { "src": "/(.*\\.html)?", "dest": "/api/index.js?__path=/$1" },
    { "src": "/api/(.*)", "dest": "/api/index.js?__path=/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.js?__path=/$1" }
  ]
}
