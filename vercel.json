{
  "functions": {
    "api/index.js": { "includeFiles": "app/{index,pengelola,checkin}.html" }
  },
  "routes": [
    { "src": "/pengunjung/?", "status": 302, "headers": { "Location": "/app/pengunjung.html" } },
    { "src": "/pengelola/?", "status": 302, "headers": { "Location": "/app/pengelola.html" } },
    { "src": "/command-center/?", "status": 302, "headers": { "Location": "/app/index.html" } },
    { "src": "/checkin/?", "status": 302, "headers": { "Location": "/app/checkin.html" } },
    { "src": "/app/?((?:index|pengelola|checkin)\\.html)?", "dest": "/api/index.js?__page=$1" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)\\.(js|html|css)", "headers": { "Cache-Control": "no-store" }, "continue": true },
    { "handle": "filesystem" }
  ]
}
