{
  "functions": {
    "api/index.js": { "includeFiles": "{index.html,app/*.html}" }
  },
  "routes": [
    { "src": "/(.*)\\.(js|css)", "headers": { "Cache-Control": "no-store" }, "continue": true },
    { "src": "/(.*\\.html)?", "dest": "/api/index.js?__path=/$1" },
    { "src": "/api/(.*)", "dest": "/api/index.js?__path=/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.js?__path=/$1" }
  ]
}
